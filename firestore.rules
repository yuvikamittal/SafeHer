rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Signed-in user can read/write only their own profile + subcollections.
    match /users/{uid} {
      allow read, write: if request.auth != null && request.auth.uid == uid;

      match /{document=**} {
        allow read, write: if request.auth != null && request.auth.uid == uid;
      }
    }
    // Any authenticated user may CREATE an access request.
    match /access_requests/{docId} {
      allow create: if request.auth != null;
      allow read, update, delete: if false;
    }
    // SOS alerts: owner can create + read/update their own; deletes locked.
    match /sos_alerts/{alertId} {
      allow create: if request.auth != null
                    && request.resource.data.uid == request.auth.uid;
      allow read, update: if request.auth != null
                          && resource.data.uid == request.auth.uid;
      allow delete: if false;
    }
  }
}
